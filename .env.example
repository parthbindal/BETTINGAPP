# ---------- Core ----------
# SQLite for local development. For production use Postgres:
#   DATABASE_URL="postgresql://user:pass@host:5432/edgewise"
#   then run: npm run db:use-postgres && npx prisma migrate dev
DATABASE_URL="file:./prisma/dev.db"
BETTER_AUTH_SECRET="replace-with-32+random-bytes"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- AI (Anthropic) ----------
# Get a key at https://console.anthropic.com/settings/keys (it starts "sk-ant-").
# Paste it between the quotes below and restart the app to turn on the real AI
# Analyst. Leave empty to run the analyst in rule-based (non-LLM) mode.
ANTHROPIC_API_KEY=""
# Default model. Set to claude-haiku-5-5 to cut cost for free-tier traffic.
ANTHROPIC_MODEL="claude-opus-5-5"

# ---------- Stripe (one paid plan: Pro) ----------
# To turn on checkout: create a Stripe account (free), put your TEST secret key
# below, then run `npm run stripe:setup` to create the Pro product/price and
# print the price id to paste into STRIPE_PRICE_PRO_MONTHLY. Leave empty to keep
# checkout disabled (no one can be charged). Use a live key only in production.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO_MONTHLY=""
# For webhooks: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and paste the signing secret it prints here.
STRIPE_WEBHOOK_SECRET=""

# ---------- Data providers ----------
# Kalshi public market data needs no key. Set a key only for authenticated endpoints.
KALSHI_API_BASE="https://api.elections.kalshi.com/trade-api/v2"
# Live NBA data (basketball). Get a free key at https://balldontlie.io. Free tier =
# real teams, players and games. Box-score projections need the ALL-STAR tier. Leave
# empty to keep the fictional demo sports dataset. Then run: npm run sync:sports
BALLDONTLIE_API_KEY=""
# Requests/min for the sports sync: 5 (free), 60 (ALL-STAR), 600 (GOAT).
BALLDONTLIE_RPM="5"

# ---------- Email (Resend) ----------
RESEND_API_KEY=""
EMAIL_FROM="EDGEWISE <hello@example.com>"

# ---------- Jobs ----------
# Shared secret for cron endpoints (/api/jobs/*)
CRON_SECRET="replace-me"

# ---------- Admin ----------
# Comma-separated emails that get the admin role on sign-up
ADMIN_EMAILS=""
